__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
dist/
build/
.eggs/

# Wannier90 large binary / run files
UNK*
*.UNK
*.chk
*.wout
*.wfc*
*.upf
*.UPF
# ...except the pseudos the workflows/ notebooks ship deliberately
!workflows/pseudos/*.upf
!workflows/pseudos/*.UPF

# QE run directories and output
*.out
# ...except small real reference output samples committed as test fixtures
!tests/data/*.out
!tests/data/**/*.out

# waw output files
*_hr.dat
*_centres.xyz
*.chk.fmt
*.xsf

# Claude Code local state
.claude/

# QE scratch (regenerated by running the notebooks). These two now hold only
# compatibility symlinks into runs/; the data itself lives one level up.
workflows/w90tutorial/runs/
workflows/notebooks/runs/

# One-off probe scripts and their logs. Not runs -- they were sitting inside the
# run namespace as `_diagnostics`, which is why nothing could tell what code had
# produced that directory: no code had.
workflows/notebooks/diagnostics/

# Run data is scratch, but its manifests are the only record of WHAT the 470 GB
# on this machine actually is, so those are tracked and the data is not.
runs/**
!runs/**/
!runs/**/RUN.json
!runs/README.md

.ipynb_checkpoints/

# scratch logs / working copies of third-party reference papers -- not repo content
*.log
/*.pdf
/pdf/

# NFS silly-rename leftovers (a deleted file still held open by a process)
.nfs*
