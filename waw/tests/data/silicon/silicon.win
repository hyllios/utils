! Silicon — 4 valence sp3 Wannier functions
! Isolated manifold: no disentanglement needed.
! Reference run for validating the waw optimization engine.

num_wann   = 4
num_bands  = 4

! Ask W90 to write the Hamiltonian and centres for comparison
write_hr_diag         = .true.
write_xyz             = .true.

! Convergence settings — tight, so our engine has a precise target
conv_tol              = 1.0e-10
conv_window           = 5
num_iter              = 500

! The 4x4x4 Gamma-centred mesh used in the NSCF calculation
mp_grid = 4 4 4

! FCC primitive cell in Angstrom
! a1 = a/2 (0,1,1),  a2 = a/2 (1,0,1),  a3 = a/2 (1,1,0)  with a = 5.431 Ang
begin unit_cell_cart
Ang
 0.000000   2.715500   2.715500
 2.715500   0.000000   2.715500
 2.715500   2.715500   0.000000
end unit_cell_cart

begin atoms_frac
Si  0.000000  0.000000  0.000000
Si  0.250000  0.250000  0.250000
end atoms_frac

! sp3 hybrids centred on the first Si atom only (fractional coords 0,0,0).
! "Si:sp3" would apply to both Si atoms (8 projections total) and conflict
! with num_wann=4. Using f= pins the projection to one site: 4 hybrids only.
begin projections
f=0.0,0.0,0.0:sp3
end projections

! All 64 k-points of the 4x4x4 mesh in crystal coordinates.
! Must match the K_POINTS block in nscf.in exactly.
begin kpoints
  0.000000  0.000000  0.000000
  0.000000  0.000000  0.250000
  0.000000  0.000000  0.500000
  0.000000  0.000000  0.750000
  0.000000  0.250000  0.000000
  0.000000  0.250000  0.250000
  0.000000  0.250000  0.500000
  0.000000  0.250000  0.750000
  0.000000  0.500000  0.000000
  0.000000  0.500000  0.250000
  0.000000  0.500000  0.500000
  0.000000  0.500000  0.750000
  0.000000  0.750000  0.000000
  0.000000  0.750000  0.250000
  0.000000  0.750000  0.500000
  0.000000  0.750000  0.750000
  0.250000  0.000000  0.000000
  0.250000  0.000000  0.250000
  0.250000  0.000000  0.500000
  0.250000  0.000000  0.750000
  0.250000  0.250000  0.000000
  0.250000  0.250000  0.250000
  0.250000  0.250000  0.500000
  0.250000  0.250000  0.750000
  0.250000  0.500000  0.000000
  0.250000  0.500000  0.250000
  0.250000  0.500000  0.500000
  0.250000  0.500000  0.750000
  0.250000  0.750000  0.000000
  0.250000  0.750000  0.250000
  0.250000  0.750000  0.500000
  0.250000  0.750000  0.750000
  0.500000  0.000000  0.000000
  0.500000  0.000000  0.250000
  0.500000  0.000000  0.500000
  0.500000  0.000000  0.750000
  0.500000  0.250000  0.000000
  0.500000  0.250000  0.250000
  0.500000  0.250000  0.500000
  0.500000  0.250000  0.750000
  0.500000  0.500000  0.000000
  0.500000  0.500000  0.250000
  0.500000  0.500000  0.500000
  0.500000  0.500000  0.750000
  0.500000  0.750000  0.000000
  0.500000  0.750000  0.250000
  0.500000  0.750000  0.500000
  0.500000  0.750000  0.750000
  0.750000  0.000000  0.000000
  0.750000  0.000000  0.250000
  0.750000  0.000000  0.500000
  0.750000  0.000000  0.750000
  0.750000  0.250000  0.000000
  0.750000  0.250000  0.250000
  0.750000  0.250000  0.500000
  0.750000  0.250000  0.750000
  0.750000  0.500000  0.000000
  0.750000  0.500000  0.250000
  0.750000  0.500000  0.500000
  0.750000  0.500000  0.750000
  0.750000  0.750000  0.000000
  0.750000  0.750000  0.250000
  0.750000  0.750000  0.500000
  0.750000  0.750000  0.750000
end kpoints
